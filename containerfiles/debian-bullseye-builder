FROM rust:1.88.0-bullseye

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PATH=/root/.local/bin:$PATH

RUN set -eux; \
        S=http://snapshot.debian.org/archive; T=20260901T000000Z; \
        printf '%s\n' \
          "deb [check-valid-until=no] $S/debian/$T bullseye main" \
          "deb [check-valid-until=no] $S/debian/$T bullseye-updates main" \
          "deb [check-valid-until=no] $S/debian-security/$T bullseye-security main" \
          > /etc/apt/sources.list; \
	apt-get update; \
	apt-get install -y --no-install-recommends \
		ca-certificates \
		netbase \
		tzdata \
                ninja-build \
	; \
	uv tool install meson ; \
	uv tool install cmake==3.31.6 ; \
	rm -rf /var/lib/apt/lists/*
